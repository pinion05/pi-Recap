{
  "name": "@npmc_5/pi-recap",
  "version": "0.1.1",
  "description": "pi-Recap — a context-sharing familiar summarizes each tool result into 1–3 lines; old results are secretly swapped with recaps (recoverable).",
  "type": "module",
  "scripts": {
    "build": "echo 'nothing to build'",
    "check": "for f in index.ts src/*.ts; do node --experimental-strip-types --check \"$f\" || exit 1; done",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": ["pi-package", "context", "compression", "recap"],
  "repository": { "type": "git", "url": "git+https://github.com/pinion05/pi-Recap.git" },
  "license": "MIT",
  "bugs": { "url": "https://github.com/pinion05/pi-Recap/issues" },
  "homepage": "https://github.com/pinion05/pi-Recap#readme",
  "files": ["index.ts", "src/", "test/", "*.md"],
  "pi": { "extensions": ["./index.ts"] },
  "devDependencies": { "tsx": "^4.19.2" },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@sinclair/typebox": "*"
  }
}
